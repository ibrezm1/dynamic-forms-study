{
  "name": "dynamic-forms-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "angular-fe",
    "node-be"
  ],
  "scripts": {
    "start:be": "npm start --workspace=node-be",
    "start:fe": "npm start --workspace=angular-fe",
    "start": "concurrently \"npm run start:be\" \"npm run start:fe\"",
    "test:fe": "npm test --workspace=angular-fe",
    "build:fe": "npm run build --workspace=angular-fe",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
